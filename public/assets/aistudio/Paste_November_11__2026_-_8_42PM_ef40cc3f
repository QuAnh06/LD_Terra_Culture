  <!-- SCRIPT FOR NAVIGATION & INTERACTIONS -->
  <script>
    // Navigation Router
    function navigateTo(viewId) {
      // 1. Hide all views
      document.querySelectorAll('.page-view').forEach(view => {
        view.classList.remove('active-view');
      });

      // 2. Show targeted view
      const targetView = document.getElementById('view-' + viewId);
      if (targetView) {
        targetView.classList.add('active-view');
      }

      // 3. Update header active tab
      document.querySelectorAll('.nav-item').forEach(item => {
        item.classList.remove('active');
        if (item.getAttribute('data-target') === viewId) {
          item.classList.add('active');
        }
      });

      // 4. Scroll smoothly to top
      window.scrollTo({ top: 0, behavior: 'smooth' });

      // Update URL hash without reload
      history.pushState(null, null, '#' + viewId);
    }

    // Hash navigation on load
    window.addEventListener('load', () => {
      const hash = window.location.hash.replace('#', '');
      if (hash && document.getElementById('view-' + hash)) {
        navigateTo(hash);
      }
    });

    // Handle Projects Filter
    function filterProjects(category, clickedElement) {
      // Active state on tabs
      document.querySelectorAll('.filter-tab').forEach(tab => tab.classList.remove('active'));
      clickedElement.classList.add('active');

      // Filter project cards
      const cards = document.querySelectorAll('.project-grid-8 .project-card');
      cards.forEach(card => {
        if (category === 'all' || card.getAttribute('data-category') === category) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Live news search
    function handleNewsSearch(query) {
      const q = query.toLowerCase().trim();
      const newsItems = document.querySelectorAll('.news-list-item');
      newsItems.forEach(item => {
        const text = item.innerText.toLowerCase();
        item.style.display = text.includes(q) ? 'grid' : 'none';
      });
    }

    // Contact Form submission
    function handleContactSubmit(e) {
      e.preventDefault();
      alert('Thank you! Your message has been sent to Terra Culture Lab (Paris & Hanoi offices). We will respond promptly.');
      e.target.reset();
    }
  </script>
