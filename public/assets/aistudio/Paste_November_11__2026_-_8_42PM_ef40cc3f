<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TERRA Culture Lab — Where Ideas Meet the World</title>
  <!-- Google Fonts: Editorial Serif + Clean Modern Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg-cream: #f7f4ed;
      --bg-card: #fdfbf7;
      --bg-dark: #121212;
      --bg-dark-card: #1c1c1c;
      --text-dark: #1d1b18;
      --text-muted: #6f6b64;
      --text-light: #ece9e2;
      --accent-rust: #b24b27;
      --accent-rust-hover: #913a1b;
      --border-color: #e4dfd5;
      --border-dark: #2b2a28;
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-heading: 'Cinzel', serif;
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --container-max: 1260px;
      --transition: all 0.35s ease;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-cream);
      color: var(--text-dark);
      font-family: var(--font-sans);
      font-size: 15px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
      transition: var(--transition);
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    .container {
      width: 90%;
      max-width: var(--container-max);
      margin: 0 auto;
    }

    /* TYPOGRAPHY */
    h1, h2, h3, h4, .serif-font {
      font-family: var(--font-serif);
      font-weight: 500;
      letter-spacing: -0.01em;
      color: var(--text-dark);
    }

    .eyebrow {
      font-family: var(--font-sans);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 2.5px;
      color: var(--accent-rust);
      font-weight: 600;
      margin-bottom: 12px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .eyebrow-divider {
      width: 32px;
      height: 2px;
      background-color: var(--accent-rust);
      display: inline-block;
      margin-bottom: 20px;
      position: relative;
    }
    .eyebrow-divider::after {
      content: '';
      position: absolute;
      right: -6px;
      top: -2.5px;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent-rust);
    }

    /* BUTTONS */
    .btn-terracotta {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background-color: var(--accent-rust);
      color: #fff;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      padding: 14px 28px;
      border: none;
      border-radius: 2px;
      cursor: pointer;
      transition: var(--transition);
    }
    .btn-terracotta:hover {
      background-color: var(--accent-rust-hover);
      transform: translateY(-1px);
    }

    .btn-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--accent-rust);
      border: none;
      background: transparent;
      cursor: pointer;
      padding-bottom: 2px;
    }
    .btn-link:hover {
      gap: 12px;
      color: var(--accent-rust-hover);
    }

    /* HEADER & NAVIGATION */
    header {
      background-color: var(--bg-cream);
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 1000;
      transition: var(--transition);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 24px 0;
    }

    .logo-container {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      cursor: pointer;
    }

    .logo-map-icon {
      width: 64px;
      height: 20px;
      fill: #8f6044;
      opacity: 0.85;
      margin-bottom: 2px;
    }

    .brand-title {
      font-family: var(--font-heading);
      font-size: 26px;
      letter-spacing: 6px;
      font-weight: 700;
      color: #4b3628;
      line-height: 1;
    }
    .brand-title span {
      display: block;
      font-family: var(--font-serif);
      font-size: 15px;
      letter-spacing: 3px;
      text-transform: none;
      font-weight: 400;
      color: #634b39;
      margin-top: 2px;
    }
    .brand-tagline {
      font-size: 9px;
      letter-spacing: 1.2px;
      color: #8c8276;
      margin-top: 4px;
      font-style: italic;
      font-family: var(--font-serif);
    }

    .nav-menu {
      display: flex;
      align-items: center;
      list-style: none;
      gap: 34px;
    }

    .nav-item a {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 1.8px;
      text-transform: uppercase;
      color: #2e2a25;
      position: relative;
      padding: 6px 0;
    }

    .nav-item.active a {
      color: var(--accent-rust);
    }

    .nav-item.active a::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 100%;
      height: 1.5px;
      background-color: var(--accent-rust);
    }
    .nav-item.active a::before {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 50%;
      transform: translateX(-50%);
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background-color: var(--accent-rust);
    }

    .lang-switcher {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1.5px;
      color: #7b756d;
      border-left: 1px solid var(--border-color);
      padding-left: 20px;
      margin-left: 10px;
    }
    .lang-switcher span.active {
      color: var(--text-dark);
      font-weight: 700;
    }

    /* PAGE SECTIONS MANAGEMENT */
    .page-view {
      display: none;
      opacity: 0;
      transition: opacity 0.4s ease;
      min-height: calc(100vh - 400px);
    }
    .page-view.active-view {
      display: block;
      opacity: 1;
    }

    /* WORLD MAP BACKGROUND (VECTOR DOTS SVG) */
    .world-map-backdrop {
      position: absolute;
      top: 0;
      right: 0;
      width: 65%;
      height: 100%;
      pointer-events: none;
      opacity: 0.18;
      z-index: 0;
      background-image: radial-gradient(#9d5d36 1px, transparent 1px);
      background-size: 14px 14px;
      mask-image: radial-gradient(ellipse at 70% 40%, black 30%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse at 70% 40%, black 30%, transparent 75%);
    }

    /* ===================================================
       1. HOME PAGE
    =================================================== */
    .home-hero {
      position: relative;
      padding: 60px 0 80px 0;
      overflow: hidden;
      border-bottom: 1px solid var(--border-color);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 40px;
    }

    .hero-content {
      z-index: 2;
    }

    .hero-title {
      font-size: 64px;
      line-height: 1.05;
      margin: 16px 0 24px;
      text-transform: uppercase;
      font-weight: 600;
      color: #1a1613;
    }

    .hero-subtitle {
      font-size: 17px;
      color: var(--text-muted);
      line-height: 1.6;
      max-width: 480px;
      margin-bottom: 36px;
    }

    .scroll-indicator {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #8c8276;
      margin-top: 60px;
    }

    .hero-artwork {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .artwork-frame {
      width: 100%;
      max-width: 460px;
      aspect-ratio: 1/1;
      border-radius: 50%;
      background: radial-gradient(circle, #f2ece0 0%, #ebe2d3 100%);
      box-shadow: 0 25px 60px rgba(0,0,0,0.06);
      position: relative;
      overflow: hidden;
      display: flex;
    }

    .split-image-container {
      width: 100%;
      height: 100%;
      display: flex;
      position: relative;
    }
    .split-left {
      width: 50%;
      height: 100%;
      overflow: hidden;
      position: relative;
      filter: saturate(1.1) contrast(1.1);
      border-right: 1.5px solid rgba(178, 75, 39, 0.4);
    }
    .split-right {
      width: 50%;
      height: 100%;
      overflow: hidden;
      position: relative;
    }
    .split-left img, .split-right img {
      width: 200%;
      height: 100%;
      object-fit: cover;
      position: absolute;
      top: 0;
    }
    .split-left img { left: 0; }
    .split-right img { left: -100%; }

    /* Splatter circle overlay */
    .brush-circle {
      position: absolute;
      inset: -5%;
      width: 110%;
      height: 110%;
      border: 14px solid rgba(178, 75, 39, 0.22);
      border-radius: 50%;
      border-top-color: var(--accent-rust);
      border-bottom-color: transparent;
      pointer-events: none;
      transform: rotate(-25deg);
    }

    /* HOME DARK SECTION: WHAT WE DO BANNER */
    .home-dark-banner {
      background-color: var(--bg-dark);
      color: #fff;
      padding: 70px 0;
    }
    .home-dark-grid {
      display: grid;
      grid-template-columns: 1.2fr 3fr;
      gap: 50px;
      align-items: center;
    }
    .dark-headline {
      font-size: 38px;
      line-height: 1.2;
      color: #fff;
      font-family: var(--font-serif);
    }
    .dark-cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
    .dark-card {
      border-left: 1px solid var(--border-dark);
      padding-left: 20px;
    }
    .card-icon {
      width: 34px;
      height: 34px;
      color: var(--accent-rust);
      margin-bottom: 14px;
      stroke: var(--accent-rust);
    }
    .dark-card h4 {
      color: #fff;
      font-family: var(--font-sans);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 10px;
    }
    .dark-card p {
      color: #9f9b94;
      font-size: 12.5px;
      line-height: 1.5;
    }

    /* FEATURED PROJECTS */
    .section-featured-projects {
      padding: 90px 0;
    }
    .section-top-bar {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 40px;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 16px;
    }
    .section-title {
      font-family: var(--font-sans);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-weight: 700;
      color: var(--accent-rust);
    }
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 28px;
    }
    .project-card {
      display: flex;
      flex-direction: column;
      cursor: pointer;
    }
    .project-card:hover .project-img img {
      transform: scale(1.04);
    }
    .project-img {
      width: 100%;
      aspect-ratio: 4/3;
      overflow: hidden;
      background-color: #e5dfd5;
      margin-bottom: 16px;
      position: relative;
    }
    .project-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .project-card h3 {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 4px;
    }
    .project-tag {
      font-size: 10.5px;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: var(--accent-rust);
      font-weight: 600;
      margin-bottom: 8px;
    }
    .project-desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 14px;
      flex-grow: 1;
    }

    /* HOME ABOUT TEASER */
    .home-about-teaser {
      display: grid;
      grid-template-columns: 1fr 1fr;
      border-top: 1px solid var(--border-color);
      margin-bottom: 60px;
    }
    .teaser-image {
      min-height: 380px;
      position: relative;
    }
    .teaser-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .teaser-content {
      padding: 60px 70px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background-color: #f3efe6;
    }
    .teaser-content h2 {
      font-size: 40px;
      line-height: 1.15;
      margin-bottom: 20px;
    }
    .teaser-content p {
      color: var(--text-muted);
      margin-bottom: 30px;
      line-height: 1.7;
    }

    /* ===================================================
       2. ABOUT PAGE
    =================================================== */
    .about-hero {
      position: relative;
      padding: 60px 0 80px 0;
      border-bottom: 1px solid var(--border-color);
    }
    .about-story-section {
      display: grid;
      grid-template-columns: 0.95fr 1.05fr;
      gap: 60px;
      align-items: center;
      padding: 80px 0;
    }
    .about-story-img {
      border-radius: 2px;
      overflow: hidden;
      aspect-ratio: 4/3;
    }
    .about-story-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .about-story-text h2 {
      font-size: 38px;
      line-height: 1.25;
      margin-bottom: 18px;
    }
    .about-story-text p {
      color: var(--text-muted);
      font-size: 16px;
      line-height: 1.8;
      margin-bottom: 14px;
    }

    /* VALUES GRID */
    .values-section {
      background: #f1ece2;
      padding: 80px 0;
      border-top: 1px solid var(--border-color);
      border-bottom: 1px solid var(--border-color);
    }
    .values-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 30px;
      margin-top: 30px;
    }
    .value-box {
      text-align: center;
      padding: 20px;
    }
    .value-icon-circle {
      width: 60px;
      height: 60px;
      margin: 0 auto 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent-rust);
    }
    .value-box h3 {
      font-family: var(--font-sans);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-weight: 700;
      margin-bottom: 12px;
    }
    .value-box p {
      font-size: 13.5px;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* TEAM SECTION */
    .team-section {
      padding: 90px 0;
    }
    .team-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 28px;
      margin: 40px 0 50px;
    }
    .team-member {
      background: #fff;
      padding-bottom: 20px;
      border: 1px solid #eae5db;
    }
    .team-photo {
      aspect-ratio: 1/1;
      overflow: hidden;
      filter: grayscale(100%);
      transition: filter 0.3s;
    }
    .team-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .team-member:hover .team-photo {
      filter: grayscale(0%);
    }
    .team-info {
      padding: 16px 14px 4px;
      text-align: center;
    }
    .team-info h4 {
      font-family: var(--font-sans);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .team-info p {
      font-size: 11px;
      color: var(--accent-rust);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    /* FULL WIDTH QUOTE BANNER */
    .quote-banner {
      position: relative;
      background: #242220;
      color: #fff;
      padding: 100px 0;
      text-align: center;
      background-image: linear-gradient(rgba(18, 17, 16, 0.7), rgba(18, 17, 16, 0.7)), url('https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1600&q=80');
      background-size: cover;
      background-position: center;
    }
    .quote-banner h2 {
      font-size: 46px;
      color: #fff;
      margin-bottom: 14px;
      font-style: italic;
    }
    .quote-banner p {
      font-size: 18px;
      color: #d6d0c6;
      letter-spacing: 1px;
    }

    /* ===================================================
       3. WHAT WE DO PAGE
    =================================================== */
    .wwd-expertise-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 20px;
      margin: 40px 0 80px;
    }
    .wwd-card {
      background: #fbf9f5;
      border: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
    }
    .wwd-card-img {
      aspect-ratio: 4/3;
      overflow: hidden;
    }
    .wwd-card-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s;
    }
    .wwd-card:hover .wwd-card-img img {
      transform: scale(1.05);
    }
    .wwd-card-body {
      padding: 20px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }
    .wwd-card-body h4 {
      font-family: var(--font-sans);
      font-size: 11.5px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      font-weight: 700;
      margin-bottom: 10px;
    }
    .wwd-card-body p {
      font-size: 12.5px;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 20px;
      flex-grow: 1;
    }

    /* PROCESS STEPS */
    .approach-section {
      padding: 70px 0;
      text-align: center;
      border-top: 1px solid var(--border-color);
    }
    .approach-steps {
      display: flex;
      justify-content: space-between;
      position: relative;
      margin-top: 50px;
    }
    .approach-steps::before {
      content: '';
      position: absolute;
      top: 25px;
      left: 10%;
      right: 10%;
      height: 1px;
      background: #d8d2c4;
      z-index: 1;
    }
    .step-item {
      position: relative;
      z-index: 2;
      flex: 1;
      padding: 0 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .step-circle {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: var(--bg-cream);
      border: 1px solid var(--accent-rust);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
      color: var(--accent-rust);
    }
    .step-number {
      font-size: 11px;
      font-weight: 700;
      color: var(--accent-rust);
      letter-spacing: 1px;
      margin-bottom: 4px;
    }
    .step-title {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .step-desc {
      font-size: 12px;
      color: var(--text-muted);
      line-height: 1.4;
      max-width: 170px;
    }

    /* ===================================================
       4. PROJECTS PAGE
    =================================================== */
    .filter-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border-color);
      padding: 15px 0;
      margin-bottom: 40px;
    }
    .filter-tabs {
      display: flex;
      gap: 26px;
      list-style: none;
      flex-wrap: wrap;
    }
    .filter-tab {
      font-size: 11px;
      letter-spacing: 1.6px;
      text-transform: uppercase;
      font-weight: 600;
      color: #635f58;
      cursor: pointer;
      position: relative;
      padding: 6px 0;
      transition: color 0.3s;
    }
    .filter-tab:hover, .filter-tab.active {
      color: var(--accent-rust);
    }
    .filter-tab.active::after {
      content: '';
      position: absolute;
      bottom: -16px;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--accent-rust);
    }

    .project-grid-8 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 30px;
      margin-bottom: 80px;
    }

    .rooted-banner {
      background: #191816;
      color: #fff;
      display: grid;
      grid-template-columns: 1fr 1fr;
      margin-bottom: 60px;
    }
    .rooted-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .rooted-content {
      padding: 50px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .rooted-content h2 {
      color: #fff;
      font-size: 34px;
      margin-bottom: 16px;
    }
    .rooted-content p {
      color: #9f9b94;
      font-size: 14px;
      margin-bottom: 30px;
    }
    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      border-top: 1px solid #333;
      padding-top: 24px;
    }
    .pillar-item h5 {
      font-family: var(--font-sans);
      font-size: 10.5px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #e4dfd5;
      margin: 8px 0 4px;
    }
    .pillar-item p {
      font-size: 11.5px;
      color: #8c8880;
      line-height: 1.4;
      margin-bottom: 0;
    }

    /* ===================================================
       5. NEWS PAGE
    =================================================== */
    .news-layout {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 50px;
      margin-bottom: 80px;
    }
    .news-featured-card {
      margin-bottom: 40px;
      padding-bottom: 40px;
      border-bottom: 1px solid var(--border-color);
    }
    .news-featured-img {
      aspect-ratio: 16/9;
      overflow: hidden;
      margin-bottom: 18px;
    }
    .news-featured-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .news-meta {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: var(--accent-rust);
      font-weight: 600;
      margin-bottom: 6px;
    }
    .news-date {
      color: #888279;
      font-size: 11px;
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .news-featured-title {
      font-size: 30px;
      margin-bottom: 12px;
      line-height: 1.25;
    }

    .news-list-item {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 22px;
      padding: 24px 0;
      border-bottom: 1px solid var(--border-color);
      align-items: center;
    }
    .news-thumb {
      aspect-ratio: 4/3;
      overflow: hidden;
    }
    .news-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .news-list-item h3 {
      font-size: 21px;
      line-height: 1.3;
      margin-bottom: 6px;
    }
    .news-list-item p {
      font-size: 13.5px;
      color: var(--text-muted);
      margin-bottom: 10px;
    }

    /* NEWS SIDEBAR */
    .sidebar-widget {
      background: #fbf9f5;
      border: 1px solid var(--border-color);
      padding: 30px;
      margin-bottom: 30px;
    }
    .sidebar-title {
      font-family: var(--font-sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--accent-rust);
      margin-bottom: 24px;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 10px;
    }
    .mini-news-item {
      display: flex;
      gap: 14px;
      margin-bottom: 20px;
    }
    .mini-news-item img {
      width: 70px;
      height: 55px;
      object-fit: cover;
    }
    .mini-news-item h5 {
      font-family: var(--font-sans);
      font-size: 12px;
      font-weight: 600;
      line-height: 1.4;
    }

    .search-box {
      display: flex;
      align-items: center;
      background: #fff;
      border: 1px solid var(--border-color);
      padding: 10px 14px;
      border-radius: 2px;
    }
    .search-box input {
      border: none;
      outline: none;
      width: 100%;
      font-size: 13px;
      background: transparent;
    }

    /* PAGINATION */
    .pagination {
      display: flex;
      gap: 8px;
      margin-top: 40px;
      align-items: center;
    }
    .page-num {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border-color);
      font-size: 12px;
      cursor: pointer;
    }
    .page-num.active {
      background: var(--accent-rust);
      color: #fff;
      border-color: var(--accent-rust);
    }

    /* ===================================================
       6. CONTACT PAGE
    =================================================== */
    .contact-hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
      padding: 60px 0 80px;
    }
    .contact-facade-img {
      border: 1px solid var(--border-color);
      aspect-ratio: 4/3;
      overflow: hidden;
      position: relative;
    }
    .contact-facade-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    /* Brass plaque mock on building */
    .brass-plaque-overlay {
      position: absolute;
      top: 30%;
      right: 15%;
      background: #e8dcc4;
      border: 1px solid #b79c6d;
      padding: 15px 22px;
      text-align: center;
      box-shadow: 2px 4px 15px rgba(0,0,0,0.3);
    }
    .brass-plaque-overlay span {
      display: block;
      font-family: var(--font-heading);
      font-size: 13px;
      letter-spacing: 2px;
      color: #3b2c1f;
    }

    .contact-form-section {
      display: grid;
      grid-template-columns: 1fr 1.6fr;
      gap: 60px;
      padding: 60px 0;
      border-top: 1px solid var(--border-color);
    }
    .contact-info-list {
      display: flex;
      flex-direction: column;
      gap: 28px;
    }
    .info-item {
      display: flex;
      gap: 16px;
    }
    .info-icon {
      color: var(--accent-rust);
      width: 24px;
      flex-shrink: 0;
    }
    .info-text h5 {
      font-family: var(--font-sans);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--accent-rust);
      margin-bottom: 4px;
    }
    .info-text p {
      font-size: 13.5px;
      color: #3b3732;
      line-height: 1.5;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 16px;
    }
    .form-group {
      margin-bottom: 16px;
    }
    .form-group input, .form-group textarea {
      width: 100%;
      padding: 14px 16px;
      border: 1px solid var(--border-color);
      background: #fdfcf9;
      font-family: var(--font-sans);
      font-size: 13.5px;
      outline: none;
      transition: border-color 0.3s;
    }
    .form-group input:focus, .form-group textarea:focus {
      border-color: var(--accent-rust);
      background: #fff;
    }

    /* OFFICES WORLDWIDE */
    .where-we-are {
      padding: 80px 0;
      border-top: 1px solid var(--border-color);
    }
    .offices-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr 1fr 1fr;
      gap: 24px;
      margin-top: 40px;
    }
    .map-preview-col {
      background: #ebe5d8;
      padding: 30px;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      min-height: 280px;
    }
    .office-card {
      background: #fff;
      border: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
    }
    .office-photo {
      aspect-ratio: 4/3;
      overflow: hidden;
    }
    .office-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .office-content {
      padding: 20px;
      flex-grow: 1;
    }
    .office-content h4 {
      font-family: var(--font-sans);
      font-size: 11px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      font-weight: 700;
      margin-bottom: 10px;
    }
    .office-content p {
      font-size: 12.5px;
      color: var(--text-muted);
      line-height: 1.6;
    }

    .provisional-badge {
      display: inline-block;
      font-size: 9px;
      background: #eee6d8;
      color: #7d654c;
      padding: 2px 6px;
      border-radius: 2px;
      margin-top: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* ===================================================
       FOOTER
    =================================================== */
    footer {
      background-color: var(--bg-dark);
      color: #b5b0a7;
      padding: 70px 0 30px;
      border-top: 1px solid #292826;
      font-size: 13px;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1.2fr 1.4fr;
      gap: 40px;
      padding-bottom: 50px;
      border-bottom: 1px solid #232220;
    }
    .footer-col h5 {
      font-family: var(--font-sans);
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #fff;
      margin-bottom: 18px;
    }
    .footer-links {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .footer-links a {
      color: #8f8b83;
    }
    .footer-links a:hover {
      color: var(--accent-rust);
    }
    .footer-social-icons {
      display: flex;
      gap: 16px;
      margin-top: 18px;
    }
    .footer-social-icons a {
      color: #9f9b93;
      font-size: 16px;
    }
    .footer-social-icons a:hover {
      color: var(--accent-rust);
    }

    .newsletter-form {
      display: flex;
      margin-top: 14px;
    }
    .newsletter-form input {
      flex: 1;
      padding: 12px 14px;
      background: #1e1e1e;
      border: 1px solid #333;
      color: #fff;
      font-size: 12px;
      outline: none;
    }
    .newsletter-form button {
      background: var(--accent-rust);
      border: none;
      color: #fff;
      padding: 0 18px;
      cursor: pointer;
    }

    .footer-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 24px;
      font-size: 11px;
      color: #6a665f;
    }
    .footer-bottom-links {
      display: flex;
      gap: 20px;
    }

    /* RESPONSIVE MEDIA QUERIES */
    @media (max-width: 1024px) {
      .hero-grid, .about-story-section, .contact-hero-grid, .contact-form-section, .home-dark-grid, .home-about-teaser, .rooted-banner {
        grid-template-columns: 1fr;
      }
      .projects-grid, .project-grid-8, .wwd-expertise-grid, .values-grid, .team-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .offices-grid {
        grid-template-columns: 1fr 1fr;
      }
      .dark-cards {
        grid-template-columns: repeat(2, 1fr);
      }
      .news-layout {
        grid-template-columns: 1fr;
      }
      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }
      .approach-steps {
        flex-direction: column;
        gap: 30px;
      }
      .approach-steps::before {
        display: none;
      }
    }

    @media (max-width: 768px) {
      .header-inner {
        flex-direction: column;
        gap: 20px;
      }
      .nav-menu {
        flex-wrap: wrap;
        justify-content: center;
        gap: 16px;
      }
      .hero-title {
        font-size: 42px;
      }
      .projects-grid, .project-grid-8, .wwd-expertise-grid, .values-grid, .team-grid, .offices-grid, .dark-cards {
        grid-template-columns: 1fr;
      }
      .footer-grid {
        grid-template-columns: 1fr;
      }
      .form-row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
